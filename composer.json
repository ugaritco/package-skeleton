{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "vendor-name/skeleton",
    "description": "A Ugarit package skeleton.",
    "keywords": [
        "vendor-name",
        "ugarit",
        "skeleton"
    ],
    "homepage": "https://github.com/vendor-name/skeleton",
    "license": "MIT",
    "authors": [
        {
            "name": "Muath R Abu Ouda",
            "email": "muathrabuouda@hotmail.com",
            "role": "Vision Leader of Ugarit"
        },
        {
            "name": "Author Name",
            "email": "author@example.com",
            "role": "Developer"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com",
            "role": "Original Creator & Primary Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "heritage/support": "^1.00.00"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "ugarit/agent-detector": "^1.00.00",
        "ugarit/chisel": "^1.00.00",
        "ugarit/pint": "^1.00.00",
        "ugarit/prompts": "^1.00.00",
        "ugarit/pao": "^1.00.00",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-ugarit": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "VendorName\\Skeleton\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VendorName\\Skeleton\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php configure.php"
        ],
        "post-update-cmd": [
            "@php configure.php"
        ],
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "ugarit": {
            "providers": [
                "VendorName\\Skeleton\\SkeletonServiceProvider"
            ],
            "aliases": {
                "Skeleton": "VendorName\\Skeleton\\Facades\\Skeleton"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "version": "1.00.00"
}
